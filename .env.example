PORT=5173
# CLI adapters are the default. Authenticate the installed tools in a terminal.
# Optional absolute executable paths (otherwise PATH is used):
# STUDIO_CLAUDE_CLI=/path/to/claude
# STUDIO_CODEX_CLI=/path/to/codex
# STUDIO_GEMINI_CLI=/path/to/gemini

# Optional API mode, never selected as a fallback for a failed CLI.
# Defining both variables below creates a legacy API provider on first startup.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Other providers are created in the UI using the NAME of a server environment variable.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

TEST_IMAGE=node:22-alpine
# Optional local transcription via OpenAI Whisper CLI; install Whisper + FFmpeg first.
# STUDIO_STT_COMMAND=["whisper"]
STUDIO_STT_MODEL=base
# Optional web search service. Without it public DuckDuckGo HTML is attempted.
# BRAVE_SEARCH_API_KEY=

# Required when serving through a public HTTPS reverse proxy. Keep server on loopback.
# STUDIO_PUBLIC_ORIGIN=https://studio.example.com
# STUDIO_AUTH_TOKEN=use-a-long-random-secret
