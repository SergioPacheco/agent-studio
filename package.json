{
  "name": "agent-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/engine.mjs && node --check public/app.js && node --check public/visuals.js"
  }
}
